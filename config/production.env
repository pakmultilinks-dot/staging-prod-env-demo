# Production environment configuration for EnvBoard (sample app).
# Non-secret values only. Real secrets never live in this repo;
# they belong in GitHub Environment secrets (see RUNBOOK.md).
APP_ENV=production
APP_DISPLAY_NAME=EnvBoard
API_BASE_URL=https://api.envboard.example
BANNER_TEXT=Live production service
THEME_COLOR=#166534
LOG_LEVEL=warn
FEATURE_BETA_DASHBOARD=false
FEATURE_NEW_CHECKOUT=true
SUPPORT_EMAIL=support@envboard.example
ITEMS_PER_PAGE=25
SESSION_TIMEOUT_MINUTES=60

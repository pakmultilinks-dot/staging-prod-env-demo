# Staging environment configuration for EnvBoard (sample app).
# Non-secret values only. Real secrets never live in this repo;
# they belong in GitHub Environment secrets (see RUNBOOK.md).
APP_ENV=staging
APP_DISPLAY_NAME=EnvBoard (Staging)
API_BASE_URL=https://api-staging.envboard.example
BANNER_TEXT=STAGING ENVIRONMENT: test data only, not for customers
THEME_COLOR=#b45309
LOG_LEVEL=debug
FEATURE_BETA_DASHBOARD=true
FEATURE_NEW_CHECKOUT=false
SUPPORT_EMAIL=staging-alerts@envboard.example
ITEMS_PER_PAGE=10
SESSION_TIMEOUT_MINUTES=15
